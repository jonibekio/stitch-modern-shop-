# Docker Compose Environment Variables
# O'zgartirish kerak bo'lgan qiymatlar:

# Django secret key (production uchun o'zgartiring)
DJANGO_SECRET_KEY=shirinliklar-enterprise-secret-key-2024-production

# Debug mode (production uchun False)
DJANGO_DEBUG=False

# Database
DB_ENGINE=django.db.backends.postgresql
DB_NAME=shirinliklar_db
DB_USER=postgres
DB_PASSWORD=postgres

# Frontend API URL (LAN uchun o'zgartiring)
NEXT_PUBLIC_API_URL=http://localhost/api
